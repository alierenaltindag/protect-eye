# Maintainer: ProtectEye Team <protecteye@example.com>
pkgname=protecteye
pkgver=1.0.11
pkgrel=1



pkgdesc="Göz Sağlığı ve Mola Takip Asistanı (Wayland, GNOME & KDE Uyumlu)"
arch=('x86_64')
url="https://github.com/alierenaltindag/protect-eye"
license=('MIT')
depends=('qt6-base' 'qt6-multimedia' 'qt6-svg')
makedepends=('cmake' 'ninja')
options=('!debug')
install=protecteye.install


build() {
    local src_dir="${startdir}/../.."
    cmake -B "${srcdir}/build" -S "$src_dir" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build "${srcdir}/build"
}

check() {
    QT_QPA_PLATFORM=offscreen ctest --test-dir "${srcdir}/build" --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install "${srcdir}/build"
    install -Dm644 "${startdir}/../../LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
